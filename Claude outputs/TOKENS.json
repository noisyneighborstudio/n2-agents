{
  "$comment": "N2 Agents status panel. Geometry in points, measured programmatically off the built layout. Colours as authored.",
  "version": "2026-09-18",

  "panel": {
    "width": 360,
    "radius": 12,
    "borderWidth": 1,
    "heightAtThreeProfiles": 588,
    "sidePadding": 12,
    "contentWidth": 334,
    "material": "NSVisualEffectView, popover material"
  },

  "sections": {
    "header": 44,
    "profiles": 382,
    "recentSessions": 126,
    "footer": 31,
    "hairline": 1,
    "paddingTop": 10,
    "paddingBottom": 12
  },

  "profileCard": {
    "width": 334,
    "height": 98,
    "radius": 9,
    "paddingVertical": 8,
    "paddingHorizontal": 9,
    "rowGap": 7,
    "gapBetweenCards": 8,
    "rows": { "identity": 18, "meters": 29, "chips": 19 }
  },

  "colourBar": { "width": 3, "height": 18, "radius": 2 },

  "meter": {
    "rowHeight": 11,
    "rowGap": 7,
    "blockHeight": 29,
    "trackHeight": 4,
    "trackRadius": 2,
    "labelColumnWidth": 15,
    "valueColumnWidth": 26,
    "resetColumnWidth": 84,
    "gap": 8,
    "thresholds": { "ok": "< 50", "warn": "50 to 80", "high": "> 80" },
    "note": "reset column reserved on both rows so tracks match; only the 5h row is filled"
  },

  "chip": { "height": 17, "radius": 4, "paddingHorizontal": 6, "gap": 4 },

  "controls": {
    "sessionRow": { "height": 40, "radius": 7, "paddingVertical": 6, "paddingHorizontal": 8 },
    "fullWidthButton": { "height": 30, "radius": 8, "paddingHorizontal": 10 },
    "iconButton": { "height": 24, "width": 24, "radius": 6 },
    "inCardButton": { "height": 19, "radius": 5, "paddingHorizontal": 8 },
    "note": "macOS pointer metrics, deliberately not the 44 pt touch target"
  },

  "type": {
    "family": "SF Pro Text",
    "scale": [
      { "size": 13, "weight": 500, "use": "profile name" },
      { "size": 12.5, "weight": 400, "use": "session title, full-width button label" },
      { "size": 11.5, "weight": 400, "use": "active profile, inline action rows" },
      { "size": 11, "weight": 600, "tracking": 0.05, "transform": "uppercase", "use": "section labels" },
      { "size": 11, "weight": 400, "use": "relative time, footer" },
      { "size": 10.5, "weight": 400, "use": "chips, meters, state labels" }
    ],
    "monospace": { "family": "SF Mono", "use": "CLI command values only" }
  },

  "colour": {
    "dark": {
      "panel": "rgba(46,46,48,0.96)",
      "panelBorder": "rgba(255,255,255,0.10)",
      "hairline": "rgba(255,255,255,0.10)",
      "card": "rgba(255,255,255,0.05)",
      "cardBorder": "rgba(255,255,255,0.08)",
      "cardActive": "rgba(10,132,255,0.16)",
      "cardActiveBorder": "rgba(10,132,255,0.55)",
      "text": "#ECECEE",
      "textSecondary": "rgba(255,255,255,0.64)",
      "meterTrack": "rgba(255,255,255,0.16)",
      "meterOk": "#34C759",
      "meterWarn": "#FFB340",
      "meterHigh": "#FF6961",
      "accent": "#0A84FF",
      "link": "#7FB5FF",
      "bannerWarn": "rgba(255,179,64,0.16)",
      "bannerWarnText": "#FFC46B"
    },
    "light": {
      "panel": "rgba(250,250,250,0.97)",
      "panelBorder": "rgba(0,0,0,0.10)",
      "hairline": "rgba(0,0,0,0.09)",
      "card": "rgba(0,0,0,0.045)",
      "cardBorder": "rgba(0,0,0,0.07)",
      "cardActive": "rgba(10,95,216,0.10)",
      "cardActiveBorder": "rgba(10,95,216,0.45)",
      "text": "#1D1D1F",
      "textSecondary": "rgba(0,0,0,0.60)",
      "meterTrack": "rgba(0,0,0,0.14)",
      "meterOk": "#1E9E4A",
      "meterWarn": "#C77A00",
      "meterHigh": "#C8372F",
      "accent": "#0A5FD8",
      "link": "#0A5FD8"
    },
    "contrastNote": "secondary at 64% white measures 5.2:1 on the dark card fill; do not drop below 62%"
  },

  "profilePalette": {
    "source": "tray/icon-badge.swift",
    "hash": "djb2 over the profile name, mod 7",
    "colours": ["#3378F5", "#8C5CF5", "#1AA185", "#E84C78", "#ED940D", "#54B03B", "#D13833"],
    "names": ["blue", "purple", "teal", "pink", "amber", "green", "red"],
    "warning": "seven buckets collide often — 'Default' and 'Client' both hash to pink. Salt the hash or reserve a colour for Default."
  }
}
