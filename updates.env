# Where updates are published — the ONE place to change it. tray/build.sh bakes
# the feed URLs into the app; scripts/publish-appcast.sh uploads the release
# archives and pushes the appcasts here. install.sh keeps a copy of
# N2_UPDATES_REPO (it runs piped, with no checkout); test.sh keeps them equal.
#
# Both must be readable WITHOUT credentials: Sparkle and install.sh never
# authenticate, so a private repo serves them nothing but 404s.

# GitHub repo holding the release archives (as release assets) and the
# `appcasts` branch. Pushing to a repo other than this one needs the
# N2_UPDATES_TOKEN secret.
N2_UPDATES_REPO=noisyneighborstudio/n2-agents

# Public URL serving that `appcasts` branch; the feeds are
# $N2_FEED_BASE_URL/<stable|continuous>/appcast.xml.
N2_FEED_BASE_URL=https://raw.githubusercontent.com/$N2_UPDATES_REPO/appcasts
