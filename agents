#!/bin/sh
# agents — cohesive CLI for N2 Agents profiles. One authoritative implementation;
# the tray app shells out to this for anything with side effects.
#
#   agents list                           profiles × vendors (✓ active, 🟢 running)
#   agents vendors                        labs found on this machine, and how each isolates
#   agents active [--vendor <v>]          print the active profile
#   agents use <Profile|Default> [--vendor <v>]
#   agents run [Profile|--next|--best] [--vendor <v>] [--start-from-session=<id>] [args]   (unsaid = next best)
#   agents best [--vendor <v>] [--porcelain]  per-profile usage (5h/7d windows)
#   agents new <Name> [--vendors a,b] [--cli-only]
#   agents delete <Name> [--everything] [--yes]
#   agents repatch [Name]                 rebuild Claude clone(s) after an update
#   agents adopt [--yes]                  import existing `claudes` profiles (shared, not copied)
#   agents login <Profile> [--vendor <v>] [--switch]  sign that slot out and back in
#   agents authed <Profile>               per slot: signed in yes|no|unknown
#   agents sessions [Profile] [--vendor <v>] [--porcelain [--limit N]]  newest first; no helpers or one-shots
#   agents transfer <id> --to <Profile>|--next|--best [--from <Profile>] [--vendor <v>]
#   agents desktop [Name|--next|--best] [--vendor <v>] [--switch]
#   agents shims [--remove]               sync <vendor>-<profile> commands on PATH
#   agents app-path                       print the Claude Desktop bundle path
#   agents version
#
# A profile is an IDENTITY, not a login: "Work" holds one slot per vendor, so
# `agents use Work` moves Claude, Codex, Grok and the rest in one step.
#
# Two isolation tiers, decided by whether the vendor reads a config-dir env var
# (see vendors.sh). `env` vendors also run concurrently — a pinned process keeps
# its profile no matter what the global switch does later. `swap` vendors have
# no such lever, so for them only one profile can be live at a time.
#
# POSIX sh on purpose — no zsh/bashisms; callers can be any shell.
set -eu

root="$HOME/.n2-agents"

# Resolve symlinks (install.sh links this onto PATH) so sibling scripts and
# the bundle Info.plist are found next to the real file, not the link.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *)  self=$(dirname "$self")/$link ;;
  esac
done
self=$(cd "$(dirname "$self")" && pwd)/$(basename "$self")
scripts_dir=$(dirname "$self")

die() { echo "agents: $*" >&2; exit 1; }

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# The vendor adapter table — every lab-specific fact lives there.
. "$scripts_dir/vendors.sh"

# --- vendor selection ------------------------------------------------------

# Parse a --vendor value: one id, a comma list, or "all". Validates every entry
# so a typo fails here rather than silently doing nothing.
resolve_vendors() {
  case ${1:-} in
    ""|all) vendors_installed; return 0 ;;
  esac
  printf '%s\n' "$1" | tr ',' '\n' | while IFS= read -r v; do
    [ -n "$v" ] || continue
    v=$(lower "$v")
    vendor_known "$v" || { echo "agents: unknown vendor '$v' (known: $N2_VENDORS)" >&2; exit 1; }
    echo "$v"
  done
}

# A single vendor for commands that act on exactly one (run, sessions, desktop).
# With no --vendor, the first installed vendor wins, which is Claude in practice.
one_vendor() {
  if [ -n "${1:-}" ]; then
    v=$(lower "$1")
    vendor_known "$v" || die "unknown vendor '$1' (known: $N2_VENDORS)"
    echo "$v"
    return 0
  fi
  # Never the first lab in the table: that quietly made one lab everyone's
  # default. Commands that can do better than asking (run, sessions, best,
  # transfer, desktop) decide for themselves before they get here.
  die "which lab? pass --vendor <$(vendors_installed | tr '\n' '|' | sed 's/|$//')>"
}

# --- Claude Desktop --------------------------------------------------------

# Claude Desktop's bundle, wherever it actually lives. A per-user install lands
# in ~/Applications, and the tray's "Locate Claude Desktop…" writes an explicit
# path into the app's preferences — both are as valid as /Applications.
# Prints nothing and returns 1 when Claude Desktop isn't installed.
claude_app_path() {
  if [ -n "${N2_CLAUDE_APP:-}" ]; then
    [ -d "$N2_CLAUDE_APP" ] || die "N2_CLAUDE_APP is set but not a bundle: $N2_CLAUDE_APP"
    echo "$N2_CLAUDE_APP"
    return 0
  fi
  pref=$(defaults read dev.sethwebster.n2agents claudeAppPath 2>/dev/null || true)
  for p in "$pref" /Applications/Claude.app "$HOME/Applications/Claude.app"; do
    if [ -n "$p" ] && [ -d "$p/Contents" ]; then echo "$p"; return 0; fi
  done
  found=$(mdfind "kMDItemCFBundleIdentifier == 'com.anthropic.claudefordesktop'" 2>/dev/null | head -1)
  if [ -n "$found" ] && [ -d "$found/Contents" ]; then echo "$found"; return 0; fi
  return 1
}

# --- profiles --------------------------------------------------------------

valid_profile_name() {
  [ -n "$1" ] || return 1
  clean=$(printf '%s' "$1" | LC_ALL=C tr -cd 'A-Za-z0-9')
  [ "$clean" = "$1" ] || return 1
  case $(lower "$1") in default) return 1 ;; *) return 0 ;; esac
}

# All profile names: slot dirs ∪ Claude app clones (one per line, sorted, unique).
profile_names() {
  {
    if [ -d "$root" ]; then
      for d in "$root"/*/; do
        [ -d "$d" ] || continue
        name=${d%/}
        name=${name##*/}
        if valid_profile_name "$name"; then echo "$name"; fi
      done
    fi
    for a in /Applications/Claude-*.app; do
      [ -d "$a" ] || continue
      b=${a##*/}
      b=${b%.app}
      name=${b#Claude-}
      if valid_profile_name "$name"; then echo "$name"; fi
    done
  } | sort -fu
}

all_profiles() { { echo Default; profile_names; } | sort -fu; }

# Case-insensitive name -> canonical name. "default" is always valid.
resolve_profile() {
  want=$(lower "$1")
  if [ "$want" = default ]; then echo "Default"; return 0; fi
  profile_names | while IFS= read -r n; do
    if [ "$(lower "$n")" = "$want" ]; then echo "$n"; fi
  done | head -1 | grep . || return 1
}

# Config dir for one (profile, vendor) pair.
#
# Default is the only special case: until it has a slot of its own it IS the
# vendor's untouched dot dir. A slot appears either when `use` migrates the dot
# dir or when `adopt` links a claudes-era profile in — checking for the slot
# rather than for "is the dot dir a symlink" covers both, and covers the case
# where another vendor has been switched but this one hasn't.
config_dir() {  # profile, vendor
  cd_slot="$root/$1/$(vendor_slot_name "$2")"
  if [ "$1" = Default ] && [ ! -e "$cd_slot" ] && [ ! -L "$cd_slot" ]; then
    vendor_dot "$2"
  else
    echo "$cd_slot"
  fi
}

# Which vendors this profile actually has a slot for.
profile_vendors() {  # profile
  for v in $N2_VENDORS; do
    d=$(config_dir "$1" "$v")
    [ -d "$d" ] && echo "$v"
  done
  true
}

abspath() { if [ -d "$1" ]; then (cd -P "$1" 2>/dev/null && pwd); else echo "$1"; fi; }

# The profile a vendor currently resolves to. A dot dir that is still a real
# directory means the vendor was never migrated, i.e. it is on Default.
#
# Compare RESOLVED paths rather than parsing the link text: an adopted slot is
# itself a symlink into ~/.claude-profiles (see cmd_adopt), so the raw target of
# ~/.claude points outside $root even though the profile is very much ours.
active_profile() {  # vendor
  ap_dot=$(vendor_dot "$1")
  [ -L "$ap_dot" ] || { echo "Default"; return 0; }
  ap_target=$(abspath "$ap_dot")
  for ap_n in $(profile_names); do
    ap_slot="$root/$ap_n/$(vendor_slot_name "$1")"
    [ -d "$ap_slot" ] || continue
    if [ "$(abspath "$ap_slot")" = "$ap_target" ]; then echo "$ap_n"; return 0; fi
  done
  echo "Default"
}

# One answer for "which profile am I on?" across every installed vendor.
# Prints "mixed" when they disagree, which is legitimate but worth surfacing.
active_summary() {
  as_seen=""
  for v in $(vendors_installed); do
    n=$(active_profile "$v")
    case " $as_seen " in *" $n "*) ;; *) as_seen="$as_seen $n" ;; esac
  done
  set -- $as_seen
  if [ $# -eq 1 ]; then echo "$1"; elif [ $# -eq 0 ]; then echo "Default"; else echo "mixed"; fi
}

# Desktop instance running for this profile? Only meaningful for `clone` vendors.
profile_running() {  # profile
  if [ "$1" = Default ]; then
    app=$(claude_app_path) || return 1
    pgrep -f "$app/Contents/MacOS/Claude" >/dev/null 2>&1
  else
    pgrep -f "user-data-dir=$HOME/Library/Application Support/Claude-$1" >/dev/null 2>&1
  fi
}

# --- list / vendors --------------------------------------------------------

cmd_vendors() {
  printf '%-10s %-14s %-11s %-9s %-8s %s\n' "VENDOR" "CLI" "ISOLATION" "DESKTOP" "USAGE" "STATUS"
  for v in $N2_VENDORS; do
    if vendor_installed "$v"; then status="installed"; else status="missing — $(vendor_install_hint "$v")"; fi
    printf '%-10s %-14s %-11s %-9s %-8s %s\n' \
      "$v" "$(vendor_cli "$v")" "$(vendor_isolation "$v")" \
      "$(vendor_desktop "$v")" "$(vendor_usage "$v")" "$status"
  done
  echo ""
  echo "isolation=env   profiles run concurrently; each process is pinned via \$$(echo VAR)."
  echo "isolation=swap  no config-dir env var exists, so one profile at a time."
}

cmd_list() {
  warn_unadopted
  inst=$(vendors_installed)
  [ -n "$inst" ] || die "no supported agent CLI found on PATH (looked for: $N2_VENDORS)"

  # Markers stay ASCII: printf pads by BYTES, so a multi-byte glyph in a column
  # silently shortens it and the whole matrix skews.
  printf '%-8s %-14s' "DESKTOP" "PROFILE"
  for v in $inst; do printf ' %-9s' "$v"; done
  printf '\n'

  all_profiles | while IFS= read -r n; do
    if profile_running "$n"; then run="running"; else run="-"; fi
    printf '%-8s %-14s' "$run" "$n"
    for v in $inst; do
      d=$(config_dir "$n" "$v")
      if [ ! -d "$d" ]; then
        mark="-"
      elif [ "$(active_profile "$v")" = "$n" ]; then
        mark="ACTIVE"
      else
        mark="ok"
      fi
      printf ' %-9s' "$mark"
    done
    printf '\n'
  done
  echo ""
  echo "active: $(active_summary)"
}

# --- use -------------------------------------------------------------------

# Point one vendor's dot dir at a profile's slot, migrating the original
# directory into Default the first time we ever touch that vendor.
switch_vendor() {  # profile, vendor
  sv_profile=$1 sv_vendor=$2
  sv_dot=$(vendor_dot "$sv_vendor")
  sv_default="$root/Default/$(vendor_slot_name "$sv_vendor")"

  # One-time migration: the real dot dir becomes the Default slot.
  if [ -e "$sv_dot" ] && [ ! -L "$sv_dot" ]; then
    [ -e "$sv_default" ] && die "both $sv_dot and $sv_default exist — merge or remove one, then retry"
    mkdir -p "$(dirname "$sv_default")"
    mv "$sv_dot" "$sv_default"
    echo "  migrated $sv_dot -> $sv_default"
  fi

  # Always target the SLOT, never config_dir(): for a vendor whose dot dir has
  # never existed, config_dir("Default") still reports the dot dir itself, and
  # linking that to itself produces a self-referential ~/.claude. Switching to
  # Default simply gives Default a slot like any other profile.
  sv_target="$root/$sv_profile/$(vendor_slot_name "$sv_vendor")"
  mkdir -p "$sv_target"
  mkdir -p "$(dirname "$sv_dot")"
  rm -f "$sv_dot"
  ln -s "$sv_target" "$sv_dot"
  printf '  %-9s %s -> %s\n' "$sv_vendor" "$sv_dot" "$sv_target"
}

cmd_use() {
  name="" vsel=""
  while [ $# -gt 0 ]; do
    case $1 in
      --vendor) vsel=${2:-}; shift 2 ;;
      --vendor=*) vsel=${1#--vendor=}; shift ;;
      -*) die "unknown flag: $1" ;;
      *) name=$1; shift ;;
    esac
  done
  [ -n "$name" ] || die "usage: agents use <Profile|Default> [--vendor <v>]"
  want=$name; name=$(resolve_profile "$want") || die "no profile named '$want' (see: agents list)"

  targets=$(resolve_vendors "$vsel")
  [ -n "$targets" ] || die "no matching vendor is installed"

  echo "Active profile: $name"
  for v in $targets; do
    vendor_installed "$v" || { echo "  skipped $v (not installed)"; continue; }
    switch_vendor "$name" "$v"
  done
  echo "New sessions everywhere use it; running sessions keep the profile they started with."
  for v in $targets; do
    env_var=$(vendor_env "$v")
    [ -n "$env_var" ] || continue
    eval "cur=\${$env_var:-}"
    [ -n "$cur" ] && echo "note: $env_var is set in this shell and overrides the global switch for $v."
  done
  true
}

# --- rotation / usage ------------------------------------------------------

# Round-robin over all profiles (Default included), shared by `run --next`
# and `desktop --next`. The pointer is the last profile handed out.
rotation_next() {
  state_file="$root/.rotation"
  names=$(all_profiles)
  last=""
  [ -f "$state_file" ] && last=$(cat "$state_file" 2>/dev/null)
  next="" take_next=0
  for n in $names; do
    if [ "$take_next" = 1 ]; then next=$n; break; fi
    [ "$n" = "$last" ] && take_next=1
  done
  [ -n "$next" ] || next=$(printf '%s\n' "$names" | head -1)
  mkdir -p "$root"
  printf '%s' "$next" > "$state_file"
  echo "$next"
}

# Server-side usage per profile, from the endpoint the lab's own CLI reads for
# its usage screen (Claude: /usage; Codex: /status; Grok: its ACP billing call).
# Ground truth (includes web/desktop/other machines), not a local heuristic.
# Prints: name<TAB>5h%<TAB>7d%<TAB>5h-resets<TAB>note<TAB>7d-resets
#
# Only vendors whose adapter reports usage can answer this; the rest have no
# quota endpoint, and guessing from local logs would be worse than saying so.
usage_table() {  # vendor
  if ! vendor_has_usage "$1"; then
    for n in $(all_profiles); do
      d=$(config_dir "$n" "$1")
      [ -d "$d" ] || continue
      printf '%s\t-\t-\t-\tno-usage-api\n' "$n"
    done
    return 0
  fi
  ut_args=""
  for n in $(all_profiles); do
    d=$(config_dir "$n" "$1")
    [ -d "$d" ] || continue
    ut_args="$ut_args $n=$d"
  done
  [ -n "$ut_args" ] || return 0
  # shellcheck disable=SC2086
  /usr/bin/python3 - "$1" $ut_args <<'PYEOF'
import hashlib, json, os, signal, subprocess, sys, tempfile, threading, time, urllib.error, urllib.request
from datetime import datetime, timezone

def claude_creds(cfg, is_default):
    # Keychain service is "Claude Code-credentials[-<sha256(cfgdir)[:8]>]";
    # the unsuffixed entry belongs to the default ~/.claude config dir. The
    # hash is of whatever path the CLI was handed, so a slot that is a symlink
    # (adopted from `claudes`) has an entry under each path; the one written
    # last is the live login.
    paths = {cfg, os.path.realpath(cfg)}
    svcs = ['Claude Code-credentials-' + hashlib.sha256(p.encode()).hexdigest()[:8] for p in paths]
    if is_default:
        svcs.append('Claude Code-credentials')
    found = []
    for svc in svcs:
        p = subprocess.run(['security', 'find-generic-password', '-s', svc, '-w'],
                           capture_output=True, text=True)
        if p.returncode == 0:
            try:
                found.append(json.loads(p.stdout.strip()).get('claudeAiOauth', {}))
            except ValueError:
                pass
    try:
        found.append(json.load(open(cfg + '/.credentials.json')).get('claudeAiOauth', {}))
    except (OSError, ValueError):
        pass
    found = [c for c in found if c.get('accessToken')]
    if not found:
        return None, 'no-token'
    c = max(found, key=lambda c: c.get('expiresAt', 0))
    return c, 'ok' if c.get('expiresAt', 0) / 1000 > time.time() else 'stale-token'

def claude(name, cfg):
    c, status = claude_creds(cfg, name == 'Default')
    if status != 'ok':
        return status, None
    return 'ok', urllib.request.Request('https://api.anthropic.com/api/oauth/usage',
        headers={'Authorization': 'Bearer ' + c['accessToken'],
                 'anthropic-beta': 'oauth-2025-04-20', 'User-Agent': 'n2-agents'})

def claude_row(r):
    five, seven = r.get('five_hour') or {}, r.get('seven_day') or {}
    return (five.get('utilization', '-'), seven.get('utilization', '-'),
            (five.get('resets_at') or '-')[:16], (seven.get('resets_at') or '-')[:16])

def codex(name, cfg):
    # An API-key login has no plan quota to read, and no tokens.
    try:
        t = json.load(open(cfg + '/auth.json')).get('tokens') or {}
    except (OSError, ValueError):
        t = {}
    if not t.get('access_token'):
        return 'no-token', None
    url = os.environ.get('N2_CODEX_USAGE_URL', 'https://chatgpt.com/backend-api/wham/usage')
    return 'ok', urllib.request.Request(url,
        headers={'Authorization': 'Bearer ' + t['access_token'],
                 'ChatGPT-Account-Id': t.get('account_id', ''), 'User-Agent': 'n2-agents'})

def codex_row(r):
    # Plans differ in which windows they have (a 5-hour one, a weekly one, or
    # both), so each window is placed by its length, not its position.
    rl = r.get('rate_limit') or {}
    cols = {}
    for w in (rl.get('primary_window'), rl.get('secondary_window')):
        if w:
            used = 100 if rl.get('limit_reached') else w.get('used_percent', '-')
            reset = time.strftime('%Y-%m-%dT%H:%M', time.gmtime(w['reset_at'])) if w.get('reset_at') else '-'
            cols['five' if w.get('limit_window_seconds', 0) <= 5 * 3600 else 'seven'] = (used, reset)
    five, seven = cols.get('five', ('-', '-')), cols.get('seven', ('-', '-'))
    return five[0], seven[0], five[1], seven[1]

def grok(name, cfg):
    # Signed in = an auth.x.ai entry in the slot's auth.json. Its key lasts six
    # hours, so the read goes through the CLI, which renews it on the way.
    try:
        a = json.load(open(cfg + '/auth.json'))
    except (OSError, ValueError):
        a = {}
    if not any(k.startswith('https://auth.x.ai::') and v.get('key') for k, v in a.items()):
        return 'no-token', None
    return 'ok', lambda: grok_billing(cfg)

def grok_billing(cfg):
    # grok's own billing call over ACP (JSON-RPC on stdio), pinned to the slot.
    # Only the replies are parsed: its startup notices carry MCP servers' env.
    # SIGTERM ends it in ~1.5 s (closing stdin takes 4); SIGKILL if it hangs.
    p = subprocess.Popen(['grok', 'agent', 'stdio'], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                         stderr=subprocess.DEVNULL, text=True, cwd=tempfile.gettempdir(),
                         env=dict(os.environ, GROK_HOME=cfg), start_new_session=True)
    kill = lambda sig: os.killpg(p.pid, sig)
    timer = threading.Timer(20, kill, (signal.SIGKILL,))
    timer.start()
    def call(i, method, params):
        p.stdin.write(json.dumps({'jsonrpc': '2.0', 'id': i, 'method': method, 'params': params}) + '\n')
        p.stdin.flush()
        for line in p.stdout:
            try:
                m = json.loads(line)
            except ValueError:
                continue
            if isinstance(m, dict) and m.get('id') == i:
                if 'result' not in m:
                    raise RuntimeError(m.get('error'))
                return m['result']
        raise RuntimeError('grok exited')
    try:
        call(1, 'initialize', {'protocolVersion': 1, 'clientCapabilities': {}})
        return call(2, '_x.ai/billing', {})
    finally:
        timer.cancel()
        try:
            kill(signal.SIGTERM)
            p.wait(timeout=3)
        except subprocess.TimeoutExpired:
            kill(signal.SIGKILL)
            p.wait()
        except ProcessLookupError:
            p.wait()

def grok_row(r):
    # One credit pool per billing period (a week on today's plans) and no
    # 5-hour window, so it fills the 7d column alone.
    c = r.get('config') or {}
    end = (c.get('currentPeriod') or {}).get('end') or c.get('billingPeriodEnd')
    reset = datetime.fromisoformat(end.replace('Z', '+00:00')).astimezone(timezone.utc) \
        .strftime('%Y-%m-%dT%H:%M') if end else '-'
    return '-', c.get('creditUsagePercent', '-'), '-', reset

def muse(name, cfg):
    # A profile's login is in its slot's auth.json (the file backend N2 pins);
    # Default's is the one keychain item a plain `muse` uses. Never the
    # keychain for a profile: that would show Default's numbers under its name.
    try:
        t = (json.load(open(cfg + '/auth.json')).get('providers') or {}).get('meta', {}).get('access_token', '')
    except (OSError, ValueError):
        t = ''
    if not t and name == 'Default':
        p = subprocess.run(['security', 'find-generic-password', '-s', 'ai.meta.dev.credentials',
                            '-a', 'meta', '-w'], capture_output=True, text=True)
        try:
            t = json.loads(p.stdout).get('access_token', '') if p.returncode == 0 else ''
        except ValueError:
            t = ''
    if not t.startswith('dca:'):
        return 'no-token', None
    url = os.environ.get('N2_MUSE_USAGE_URL', 'https://api.meta.ai/muse-code/key')
    return 'ok', urllib.request.Request(url, data=b'{}', method='POST',
        headers={'Authorization': 'Bearer ' + t, 'x-api-version': '1.0.0',
                 'Content-Type': 'application/json', 'User-Agent': 'n2-agents'})

def muse_row(r):
    # The key endpoint (it mints an inference key we drop) reports both
    # windows: `window` is the 5-hour one, `weekly` the week.
    u = r.get('subs_usage') or {}
    cols = []
    for w in (u.get('window') or {}, u.get('weekly') or {}):
        at = w.get('resets_at')
        cols.append((w.get('used_percent', '-'),
                     time.strftime('%Y-%m-%dT%H:%M', time.gmtime(at)) if at else '-'))
    return cols[0][0], cols[1][0], cols[0][1], cols[1][1]

request, row = {'claude': (claude, claude_row), 'codex': (codex, codex_row),
                'grok': (grok, grok_row), 'muse': (muse, muse_row)}[sys.argv[1]]
for pair in sys.argv[2:]:
    name, cfg = pair.split('=', 1)
    status, req = request(name, cfg)
    if status != 'ok':
        print(f"{name}\t-\t-\t-\t{status}")
        continue
    try:
        five, seven, five_at, seven_at = row(req() if callable(req) else json.load(urllib.request.urlopen(req, timeout=10)))
        print(f"{name}\t{five}\t{seven}\t{five_at}\tok\t{seven_at}")
    except urllib.error.HTTPError as e:
        note = {429: 'rate-limited', 401: 'stale-token', 403: 'stale-token'}.get(e.code, 'fetch-error')
        print(f"{name}\t-\t-\t-\t{note}")
    except Exception:
        print(f"{name}\t-\t-\t-\tfetch-error")
PYEOF
}

# Lowest 5-hour utilization wins; ties fall to 7-day, then list order. A
# maxed profile (95%+ in either window — the last few points are unusable)
# is out of the running exactly like one with a bad token.
# Updates the rotation pointer so --next continues from the pick.
# $1 vendor, $2 (optional): profile to exclude (a resumed session's source).
pick_best() {
  pb_best="" pb_five=101 pb_seven=101
  while IFS="$(printf '\t')" read -r n five seven _ note _; do
    [ "$note" = ok ] || continue
    [ "$n" = "${2:-}" ] && continue
    # A plan may have only one of the windows; the other counts as empty.
    f=${five%.*} s=${seven%.*}
    case $f in ''|*[!0-9]*) f=0 ;; esac
    case $s in ''|*[!0-9]*) s=0 ;; esac
    [ "$f" -ge 95 ] || [ "$s" -ge 95 ] && continue
    if [ "$f" -lt "$pb_five" ] || { [ "$f" -eq "$pb_five" ] && [ "$s" -lt "$pb_seven" ]; }; then
      pb_best=$n pb_five=$f pb_seven=$s
    fi
  done <<EOF
$(usage_table "$1")
EOF
  [ -n "$pb_best" ] || return 1
  mkdir -p "$root"
  printf '%s' "$pb_best" > "$root/.rotation"
  echo "$pb_best"
}

# --porcelain prints usage_table's rows untouched — the tray's quota meters
# parse it, so like `agents porcelain` it is a contract, not a display:
#   <profile> <5h%> <7d%> <5h-resets UTC> <note: ok|no-token|stale-token|rate-limited|fetch-error|no-usage-api> [<7d-resets UTC>]
cmd_best() {
  vsel="" porcelain=0
  while [ $# -gt 0 ]; do
    case $1 in
      --vendor) vsel=${2:-}; shift 2 ;;
      --vendor=*) vsel=${1#--vendor=}; shift ;;
      --porcelain) porcelain=1; shift ;;
      *) shift ;;
    esac
  done
  if [ -z "$vsel" ]; then
    # Every lab that reports usage, not whichever sorts first.
    bv=$(for x in $(vendors_installed); do vendor_has_usage "$x" && echo "$x"; done; true)
    [ -n "$bv" ] || die "none of the installed labs reports usage"
    for x in $bv; do
      if [ "$porcelain" = 1 ]; then cmd_best --vendor "$x" --porcelain; else cmd_best --vendor "$x"; fi
    done
    return 0
  fi
  v=$(one_vendor "$vsel")
  if [ "$porcelain" = 1 ]; then
    usage_table "$v"
    return 0
  fi
  if ! vendor_has_usage "$v"; then
    echo "$(vendor_label "$v") exposes no usage API — there is nothing to rank." >&2
    echo "Vendors with usage data: $(for x in $N2_VENDORS; do vendor_has_usage "$x" && printf '%s ' "$x"; done)" >&2
    return 1
  fi
  echo "vendor: $v"
  printf '%-14s %6s %6s %-18s %s\n' "PROFILE" "5H%" "7D%" "5H RESETS (UTC)" "NOTE"
  usage_table "$v" | while IFS="$(printf '\t')" read -r n five seven resets note _; do
    [ "$note" = ok ] && note=""
    printf '%-14s %6s %6s %-18s %s\n' "$n" "$five" "$seven" "$resets" "$note"
  done
}

# --- next best -------------------------------------------------------------

# What runs when you don't say which profile or lab — no lab is anyone's
# default. Every slot (one profile's login for one lab) sits in one rotation:
# profiles in list order, labs in table order. `run` records the last slot it
# started; "next best" is the first usable slot after it, wrapping round, so
# work spreads across accounts and labs. Usable: signed in (or a lab that
# keeps its login out of sight), and — for a lab that reports quota — read
# cleanly and under 95% in both windows.
slot_file="$root/.last-slot"

remember_slot() {  # profile, vendor
  mkdir -p "$root"
  printf '%s:%s' "$1" "$2" > "$slot_file"
}

# usage_table rows, each prefixed with its vendor, for the labs that report usage.
usage_rows() {  # vendors
  for ur_v in $1; do
    vendor_has_usage "$ur_v" || continue
    usage_table "$ur_v" | sed "s/^/$ur_v	/"
  done
}

slot_signed_in() {  # profile, vendor — yes or can't tell
  si_d=$(config_dir "$1" "$2")
  [ -d "$si_d" ] || return 1
  if vendor_authed "$2" "$si_d" "$1"; then return 0; elif [ $? = 1 ]; then return 1; fi
  return 0
}

slot_has_room() {  # profile, vendor, usage rows
  vendor_has_usage "$2" || return 0
  su_row=$(printf '%s\n' "$3" | awk -F'\t' -v v="$2" -v n="$1" '$1 == v && $2 == n' | head -1)
  [ -n "$su_row" ] || return 1
  IFS="$(printf '\t')" read -r _ _ su_f su_s _ su_note _ <<EOF
$su_row
EOF
  [ "$su_note" = ok ] || return 1
  su_f=${su_f%.*} su_s=${su_s%.*}
  case $su_f in ''|*[!0-9]*) su_f=0 ;; esac
  case $su_s in ''|*[!0-9]*) su_s=0 ;; esac
  [ "$su_f" -lt 95 ] && [ "$su_s" -lt 95 ]
}

next_best() {  # profiles, vendors -> "profile vendor"; fails when nothing is usable
  nb_slots=$(for n in $1; do for v in $2; do
    vendor_installed "$v" && [ -d "$(config_dir "$n" "$v")" ] && echo "$n:$v"
  done; done; true)
  [ -n "$nb_slots" ] || return 1
  nb_last=""
  [ -f "$slot_file" ] && nb_last=$(cat "$slot_file" 2>/dev/null)
  # The slots after the last one started, then round to it.
  nb_order=$(printf '%s\n' "$nb_slots" | awk -v last="$nb_last" \
    '{ a[NR] = $0; if ($0 == last) at = NR } END { for (i = 1; i <= NR; i++) print a[(at + i - 1) % NR + 1] }')
  # Quota is a network read, so it's fetched once, and only when a signed-in
  # slot of a lab that reports it comes up.
  nb_rows="" nb_fetched=0
  for s in $nb_order; do
    nb_n=${s%%:*} nb_v=${s#*:}
    slot_signed_in "$nb_n" "$nb_v" || continue
    if vendor_has_usage "$nb_v" && [ "$nb_fetched" = 0 ]; then
      nb_rows=$(usage_rows "$2")
      nb_fetched=1
    fi
    if slot_has_room "$nb_n" "$nb_v" "$nb_rows"; then
      echo "$nb_n $nb_v"
      return 0
    fi
  done
  return 1
}

# The lab a session belongs to, found by looking in every lab that keeps them.
session_vendor() {  # id, [profile]
  for sv_v in $(vendors_installed); do
    [ "$(vendor_sessions "$sv_v")" != none ] || continue
    find_session "$1" "$sv_v" ${2:+"$2"} >/dev/null && { echo "$sv_v"; return 0; }
  done
  return 1
}

# --- run -------------------------------------------------------------------

cmd_run() {
  usage="usage: agents run [Profile|--next|--best] [--vendor <v>] [--start-from-session=<id>] [args...]"
  name="" sess="" rotate=0 best=0 vsel="" switch=0
  while [ $# -gt 0 ]; do
    case $1 in
      --next) rotate=1; shift ;;
      --best) best=1; shift ;;
      --switch) switch=1; shift ;;
      --vendor) vsel=${2:-}; shift 2 ;;
      --vendor=*) vsel=${1#--vendor=}; shift ;;
      --start-from-session=*) sess=${1#--start-from-session=}; shift ;;
      -*) break ;;  # remaining args belong to the agent CLI
      *) if [ -z "$name" ] && [ "$rotate" = 0 ] && [ "$best" = 0 ]; then name=$1; shift; else break; fi ;;
    esac
  done
  picks=$(( (rotate + best) + $( [ -n "$name" ] && echo 1 || echo 0 ) ))
  [ "$picks" -le 1 ] || die "$usage (pick at most one of a profile name, --next, --best)"
  if [ -n "$name" ]; then
    want=$name; name=$(resolve_profile "$want") || die "no profile named '$want' (see: agents list)"
  fi
  # A resumed session already says which lab it belongs to.
  if [ -z "$vsel" ] && [ -n "$sess" ]; then
    vsel=$(session_vendor "$sess") || die "session $sess not found in any profile"
  fi
  # Whatever wasn't said — the profile, the lab, or both — comes from next best.
  if [ -z "$vsel" ] || [ "$picks" = 0 ]; then
    if [ -n "$name" ]; then nb_p=$name; else nb_p=$(all_profiles); fi
    if [ -n "$vsel" ]; then nb_v=$(one_vendor "$vsel"); else nb_v=$(vendors_installed); fi
    pick=$(next_best "$nb_p" "$nb_v") || \
      die "nothing usable — no slot is signed in with room left (see: agents list, agents best)"
    name=${pick% *} vsel=${pick#* } rotate=0 best=0
    echo "agents: next best is $(vendor_label "$vsel") in '$name'" >&2
  fi

  v=$(one_vendor "$vsel")
  cli=$(vendor_cli "$v")
  command -v "$cli" >/dev/null 2>&1 || \
    die "$(vendor_label "$v") CLI not found — install it: $(vendor_install_hint "$v")"

  src=""
  if [ -n "$sess" ]; then
    hit=$(find_session "$sess" "$v") || die "session $sess not found in any profile"
    src=$(printf '%s\n' "$hit" | cut -f1)
  fi
  if [ "$rotate" = 1 ]; then
    name=$(rotation_next)
    [ -n "$sess" ] && [ "$name" = "$src" ] && name=$(rotation_next)  # already there; step past
    echo "agents: rotating to profile '$name'" >&2
  elif [ "$best" = 1 ]; then
    name=$(pick_best "$v" "$src") || die "no profile with a readable token — run 'agents best' to see why"
    echo "agents: best available profile is '$name'" >&2
  else
    want=$name; name=$(resolve_profile "$want") || die "no profile named '$want' (see: agents list)"
  fi

  cfg=$(config_dir "$name" "$v")
  [ -d "$cfg" ] || die "profile '$name' has no $v slot — create it: agents new $name --vendors $v"

  pin_swap_vendor "$name" "$v" "$switch" run
  remember_slot "$name" "$v"

  announce_auth "$v" "$name" "$cfg" "${1:-}"
  if [ -n "$sess" ]; then
    [ "$src" = "$name" ] || cmd_transfer "$sess" --from "$src" --to "$name" --vendor "$v" >&2
    hit=$(find_session "$sess" "$v" "$name") || die "session $sess missing after transfer"
    cwd=$(session_cwd "$(printf '%s\n' "$hit" | cut -f3)")
    if [ -n "$cwd" ] && [ -d "$cwd" ]; then
      cd "$cwd"
    elif [ -n "$cwd" ]; then
      echo "agents: project dir $cwd no longer exists; resuming from $PWD" >&2
    fi
    exec_vendor "$v" "$name" "$cfg" "$cli" "$(resume_flag "$v")" "$sess" "$@"
  fi
  exec_vendor "$v" "$name" "$cfg" "$cli" "$@"
}

# A swap-only vendor cannot be pinned per-process: there is no env var to set,
# so the only way to run it as this profile is to make the profile active.
# That is a global side effect, so it needs an explicit --switch.
pin_swap_vendor() {  # profile, vendor, switch 0|1, command name for the hint
  [ "$(vendor_isolation "$2")" = swap ] || return 0
  ps_cur=$(active_profile "$2")
  [ "$ps_cur" != "$1" ] || return 0
  [ "$3" = 1 ] || die "$(vendor_label "$2") has no config-dir env var, so '$1' must be the active profile (currently '$ps_cur').
  Switch globally and run:  agents $4 $1 --vendor $2 --switch
  Or switch on its own:     agents use $1 --vendor $2"
  switch_vendor "$1" "$2" >&2
}

# A sign-in writes a credential into whichever slot the process was pinned to, and the
# vendor's own login output never says which profile that is. Say it first, so a
# browser prompt cannot be answered with the wrong account for the wrong profile.
announce_auth() {  # vendor, profile, slot-dir, first vendor arg
  case ${4:-} in login|logout|auth) ;; *) return 0 ;; esac
  aa_var=$(vendor_env "$1")
  if [ -n "$aa_var" ]; then aa_where="$aa_var=$(vendor_env_value "$1" "$3")"; else aa_where=$3; fi
  echo "agents: $(vendor_label "$1") $4 for profile '$2' ($aa_where)" >&2
}

resume_flag() {
  case $1 in
    codex) echo "resume" ;;
    *)     echo "--resume" ;;
  esac
}

# Launch a vendor CLI pinned to a config dir. `env` vendors get their variable
# (and any extra the lab needs to keep its login in the slot); `swap` vendors
# were already pointed at the profile by the caller.
exec_vendor() {  # vendor, profile, cfg, cli, args...
  ev_vendor=$1 ev_profile=$2 ev_cfg=$3; shift 3
  ev_env=$(vendor_env "$ev_vendor")
  if [ -n "$ev_env" ]; then
    # shellcheck disable=SC2046
    exec env "$ev_env=$(vendor_env_value "$ev_vendor" "$ev_cfg")" \
      $(vendor_env_extra "$ev_vendor" "$ev_profile") "$@"
  fi
  exec "$@"
}

# --- login -----------------------------------------------------------------

# Sign one slot out of its lab and straight back in — for when the wrong
# account got used. Goes through the CLI's own logout/login, pinned exactly as
# `run` pins it, so the new credentials land where that CLI will look for them.
# Interactive (browser OAuth), so it belongs in a terminal.
cmd_login() {
  usage="usage: agents login <Profile> [--vendor <v>] [--switch]"
  name="" vsel="" switch=0
  while [ $# -gt 0 ]; do
    case $1 in
      --switch) switch=1; shift ;;
      --vendor) vsel=${2:-}; shift 2 ;;
      --vendor=*) vsel=${1#--vendor=}; shift ;;
      -*) die "unknown flag: $1" ;;
      *) name=$1; shift ;;
    esac
  done
  [ -n "$name" ] || die "$usage"
  want=$name; name=$(resolve_profile "$want") || die "no profile named '$want' (see: agents list)"
  # Signing out is never a guess: say which lab.
  [ -n "$vsel" ] || die "which lab? agents login $name --vendor <$(profile_vendors "$name" | tr '\n' '|' | sed 's/|$//')>"
  v=$(one_vendor "$vsel")
  cli=$(vendor_cli "$v")
  command -v "$cli" >/dev/null 2>&1 || \
    die "$(vendor_label "$v") CLI not found — install it: $(vendor_install_hint "$v")"
  cfg=$(config_dir "$name" "$v")
  [ -d "$cfg" ] || die "profile '$name' has no $v slot — create it: agents new $name --vendors $v"
  pin_swap_vendor "$name" "$v" "$switch" login

  out_args=$(vendor_logout "$v")
  if vendor_authed "$v" "$cfg" "$name"; then authed=0; else authed=$?; fi
  if [ "$authed" = 1 ]; then
    :  # nothing to sign out of — a slot being set up for the first time
  elif [ -n "$out_args" ]; then
    echo "Signing $(vendor_label "$v") out of '$name'…"
    # shellcheck disable=SC2086
    ( exec_vendor "$v" "$name" "$cfg" "$cli" $out_args ) || \
      echo "agents: '$cli $out_args' reported an error — signing in anyway" >&2
  else
    echo "Signing $(vendor_label "$v") out of '$name'…"
    for f in $(vendor_cred_files "$v"); do rm -f "$cfg/$f"; done
  fi
  echo "Now sign in with the account '$name' should use."
  in_args=$(vendor_login "$v")
  if [ -z "$in_args" ]; then
    exec_vendor "$v" "$name" "$cfg" "$cli"   # no login subcommand: the CLI asks on start
  fi
  echo "(The browser signs in with whatever account it's already using — switch it there first if needed.)"
  # shellcheck disable=SC2086
  ( exec_vendor "$v" "$name" "$cfg" "$cli" $in_args ) || die "sign-in did not complete"
  who=$(vendor_whoami "$v")
  if [ -n "$who" ]; then
    echo ""
    echo "'$name' $(vendor_label "$v") is now:"
    # shellcheck disable=SC2086
    ( exec_vendor "$v" "$name" "$cfg" "$cli" $who ) || true
  fi
}

# --- shims -----------------------------------------------------------------

# Keep profile shims beside this installation's `agents` link.
bin_dir() {
  if [ -f "$root/.bin-dir" ]; then
    IFS= read -r d < "$root/.bin-dir" || d=""
    case $d in /opt/homebrew/bin|/usr/local/bin|"$HOME/.local/bin")
      if [ -L "$d/agents" ] && [ "$(readlink "$d/agents")" = "$self" ] && [ -w "$d" ]; then
        echo "$d"
        return 0
      fi
      ;;
    esac
  fi
  old_ifs=$IFS
  IFS=:
  result=""
  for d in $PATH; do
    case $d in /opt/homebrew/bin|/usr/local/bin|"$HOME/.local/bin") ;; *) continue ;; esac
    if [ -L "$d/agents" ] && [ "$(readlink "$d/agents")" = "$self" ] && [ -w "$d" ]; then
      result=$d
      break
    fi
  done
  IFS=$old_ifs
  if [ -n "$result" ]; then
    echo "$result"
    return 0
  fi
  for d in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin"; do
    if [ -L "$d/agents" ] && [ "$(readlink "$d/agents")" = "$self" ] && [ -w "$d" ]; then
      mkdir -p "$root"
      printf '%s\n' "$d" > "$root/.bin-dir"
      echo "$d"
      return 0
    fi
  done
  return 1
}

# <vendor>-as and <vendor>-<profile> as real executables on PATH (symlinks to
# Resources/agent-as), so every app and script can pin a profile — a shell
# function only ever existed inside shells that sourced our helper.
cmd_shims() {
  remove=0
  [ "${1:-}" = --remove ] && remove=1
  src="$scripts_dir/agent-as"
  [ -f "$src" ] || src="$scripts_dir/shell/agent-as"  # dev-tree layout
  dir=$(bin_dir) || die "agents command link not found; run install.sh again"
  mkdir -p "$root"
  lock_file="$root/.shims.lock"
  attempts=0
  until /usr/bin/shlock -f "$lock_file" -p $$; do
    attempts=$((attempts + 1))
    [ "$attempts" -lt 100 ] || die "timed out waiting for another shim sync"
    sleep 0.1
  done
  cleanup_shim_lock() { rm -f "$lock_file"; }
  trap cleanup_shim_lock 0
  trap 'exit 1' 1 2 15

  # Ours = pointing at this install's agent-as, or at the one inside the
  # pre-rename N2Agents.app, which the next sync re-points here.
  our_shim() {
    case $(readlink "$1") in "$src"|*/N2Agents.app/Contents/Resources/agent-as) return 0 ;; esac
    return 1
  }

  wanted=""
  if [ "$remove" = 0 ]; then
    [ -x "$src" ] || die "shim script missing: $src"
    wanted=$(
      for v in $(vendors_installed); do
        echo "$v-as"
        for n in $(all_profiles); do
          suffix=$(lower "$n")
          [ "$suffix" = as ] && continue
          d=$(config_dir "$n" "$v")
          [ -d "$d" ] && echo "$v-$suffix"
        done
      done | sort -u
    )
  fi

  # Prune exact-owned links across every supported bin directory. This also
  # removes stale commands after the preferred PATH directory changes, and
  # cleans up shims for vendors or profiles that have gone away.
  for prune_dir in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin"; do
    for v in $N2_VENDORS; do
      for f in "$prune_dir/$v"-*; do
        [ -L "$f" ] || continue
        our_shim "$f" || continue
        if [ "$prune_dir" != "$dir" ] || ! printf '%s\n' "$wanted" | grep -qx "$(basename "$f")"; then
          rm -f "$f"
          echo "✓ removed $f"
        fi
      done
    done
  done
  [ "$remove" = 1 ] && return 0

  printf '%s\n' "$wanted" | while IFS= read -r b; do
    [ -n "$b" ] || continue
    existing=$(command -v "$b" 2>/dev/null || true)
    if [ -n "$existing" ] && [ "$existing" != "$dir/$b" ]; then
      echo "agents: $b already resolves to $existing — skipped" >&2
      continue
    fi
    if [ -e "$dir/$b" ] || [ -L "$dir/$b" ]; then
      if [ ! -L "$dir/$b" ] || ! our_shim "$dir/$b"; then
        echo "agents: $dir/$b exists and isn't ours — skipped" >&2
        continue
      fi
    fi
    ln -sf "$src" "$dir/$b"
  done
  echo "✓ <vendor>-as and <vendor>-<profile> linked in $dir"
}

# Profile list changed: keep PATH in step, but never fail the operation over it.
sync_shims() {
  ( cmd_shims ) || echo "agents: PATH shims not updated — run 'agents shims'" >&2
}

# --- new / delete ----------------------------------------------------------

cmd_new() {
  name="" cli_only=0 vsel=""
  while [ $# -gt 0 ]; do
    case $1 in
      --cli-only) cli_only=1; shift ;;
      --vendors) vsel=${2:-}; shift 2 ;;
      --vendors=*) vsel=${1#--vendors=}; shift ;;
      --vendor) vsel=${2:-}; shift 2 ;;
      --vendor=*) vsel=${1#--vendor=}; shift ;;
      -*) die "unknown flag: $1" ;;
      *) name=$1; shift ;;
    esac
  done
  [ -n "$name" ] || die "usage: agents new <Name> [--vendors a,b] [--cli-only]"
  valid_profile_name "$name" || die "profile name must be letters/numbers and not 'default': $name"
  [ "$(lower "$name")" = as ] && die "profile name is reserved: $name"

  targets=$(resolve_vendors "$vsel")
  [ -n "$targets" ] || die "no matching vendor is installed"

  created=""
  for v in $targets; do
    vendor_installed "$v" || { echo "  skipped $v (not installed — $(vendor_install_hint "$v"))"; continue; }
    slot="$root/$name/$(vendor_slot_name "$v")"
    if [ -d "$slot" ]; then
      echo "  $v: already exists ($slot)"
    else
      mkdir -p "$slot"
      echo "  $v: $slot"
    fi
    created="$created $v"
  done
  [ -n "$created" ] || die "nothing created — none of the requested vendors is installed"

  # The Claude desktop clone is the one piece that isn't just a directory.
  case " $created " in
    *" claude "*)
      if [ "$cli_only" -eq 0 ] && claude_app_path >/dev/null 2>&1; then
        if [ -d "/Applications/Claude-$name.app" ]; then
          echo "  claude desktop: /Applications/Claude-$name.app already exists"
        else
          "$scripts_dir/make-claude-profile.sh" "$name"
        fi
      elif [ "$cli_only" -eq 0 ]; then
        echo "  claude desktop: skipped (Claude Desktop not installed)"
      fi
      ;;
  esac

  sync_shims
  echo ""
  echo "✓ Profile '$name' ready."
  for v in $created; do
    slot="$root/$name/$(vendor_slot_name "$v")"
    printf '  %-9s %s-%s   (or %s)\n' "$v" "$v" "$(lower "$name")" \
      "$(e=$(vendor_env "$v"); [ -n "$e" ] && echo "$e=$(vendor_env_value "$v" "$slot") $(vendor_env_extra "$v" "$name") $(vendor_cli "$v")" | tr -s ' ' || echo "agents use $name --vendor $v")"
  done
  echo "  Sign in to each one once."
}

cmd_delete() {
  name="" everything=0 yes=0
  for arg in "$@"; do
    case $arg in
      --everything) everything=1 ;;
      --yes) yes=1 ;;
      -*) die "unknown flag: $arg" ;;
      *) name=$arg ;;
    esac
  done
  [ -n "$name" ] || die "usage: agents delete <Name> [--everything] [--yes]"
  want=$name; name=$(resolve_profile "$want") || die "no profile named '$want'"
  [ "$name" = Default ] && die "Default can't be deleted"
  for v in $(vendors_installed); do
    [ "$(active_profile "$v")" = "$name" ] && \
      die "'$name' is active for $v — run 'agents use <other> --vendor $v' first"
  done
  profile_running "$name" && die "'$name' is running — quit it first"

  app="/Applications/Claude-$name.app"
  data="$HOME/Library/Application Support/Claude-$name"
  cfg="$root/$name"
  if [ "$yes" -eq 0 ]; then
    if [ "$everything" -eq 1 ]; then extra=" AND all of its per-vendor logins/config"; else extra=""; fi
    printf "Delete profile '%s'%s? [y/N] " "$name" "$extra"
    read -r reply
    case $(lower "$reply") in y*) ;; *) echo "aborted"; exit 1 ;; esac
  fi
  [ -d "$app" ] && rm -rf "$app"
  if [ "$everything" -eq 1 ]; then
    [ -d "$data" ] && rm -rf "$data"
    [ -d "$cfg" ] && rm -rf "$cfg"
    echo "Deleted '$name' (desktop clone, data, all vendor slots)"
  else
    echo "Deleted '$name' (desktop clone only — vendor slots kept at $cfg)"
  fi
  sync_shims
}

cmd_repatch() {
  exec "$scripts_dir/repatch-claude-profiles.sh" "$@"
}

# --- adopt -----------------------------------------------------------------

legacy_root="$HOME/.claude-profiles"

# Profiles created by the older single-vendor `claudes` app.
legacy_profiles() {
  [ -d "$legacy_root" ] || return 0
  for d in "$legacy_root"/*/; do
    [ -d "$d" ] || continue
    n=${d%/}; n=${n##*/}
    case $n in .*) continue ;; esac
    echo "$n"
  done
}

# Pull `claudes` profiles in WITHOUT taking them over: each Claude slot becomes
# a symlink to the existing ~/.claude-profiles/<Name> directory, so both tools
# read and write the same login. Copying instead would force a re-login —
# Claude Code keys its keychain entry to the config dir's path — and would leave
# two diverging copies of the same account.
cmd_adopt() {
  yes=0
  for arg in "$@"; do
    case $arg in
      --yes) yes=1 ;;
      -*) die "unknown flag: $arg" ;;
    esac
  done
  found=$(legacy_profiles)
  [ -n "$found" ] || die "no claudes profiles found at $legacy_root"

  echo "Found in $legacy_root:"
  for n in $found; do echo "  $n"; done
  echo ""
  echo "Each becomes $root/<Name>/claude -> $legacy_root/<Name> (a symlink, not a copy),"
  echo "so 'claudes' keeps working on exactly the same logins."
  if [ "$yes" -eq 0 ]; then
    printf "Adopt these? [y/N] "
    read -r reply
    case $(lower "$reply") in y*) ;; *) echo "aborted"; exit 1 ;; esac
  fi

  for n in $found; do
    slot="$root/$n/claude"
    if [ -e "$slot" ] || [ -L "$slot" ]; then
      echo "  $n: already present ($slot)"
      continue
    fi
    mkdir -p "$root/$n"
    ln -s "$legacy_root/$n" "$slot"
    echo "  $n: $slot -> $legacy_root/$n"
  done
  sync_shims
  echo ""
  echo "✓ Adopted. Add other vendors to a profile with: agents new <Name> --vendors codex,grok"
}

# Nudge, once per invocation of the commands where it matters.
warn_unadopted() {
  wu=$(legacy_profiles)
  [ -n "$wu" ] || return 0
  for n in $wu; do
    [ -e "$root/$n/claude" ] || [ -L "$root/$n/claude" ] || {
      echo "note: claudes profiles exist at $legacy_root but aren't adopted yet — run 'agents adopt'" >&2
      return 0
    }
  done
  true
}

# --- sessions --------------------------------------------------------------

# Working dir of a transcript: both labs record it in their opening records.
session_cwd() {  # path
  grep -m1 -o '"cwd":"[^"]*"' "$1" 2>/dev/null | sed 's/^"cwd":"//; s/"$//' || true
}

# A JSON string's body as plain text: escapes out, and the runs of space the
# stripping leaves behind squeezed.
json_text() {
  sed 's/\\[nt]/ /g; s/\\"/"/g; s/\\\\/\\/g' | tr -s ' '
}

# What it takes to recognise a transcript a week later: where it ran, on which
# branch, what it's called, and the first real prompt.
#
# The prompt is the first text on a user-role line that isn't injected context
# — Claude's meta lines and <system-reminder>s, Codex's <environment_context>,
# AGENTS.md and file mentions — and Codex can put 100 KB of setup before it, so
# this scans whole lines rather than a fixed head.
#
# Claude records the branch on every line and names the session as it goes
# (ai-title, and custom-title from /rename, which wins): the last of each is
# the current one. Codex records git once, in its opening line, and keeps its
# names in an index beside the sessions directory.
session_meta() {  # path -> cwd \t snippet \t branch \t title
  snippet=$(grep -m 40 '"role":"user"' "$1" 2>/dev/null | grep -v '"isMeta":true' \
    | grep -o '"\(text\|content\)":"[^"]*' | sed 's/^"[a-z]*":"//' \
    | grep -v -e '^\(\\n\| \)*<' -e '^\(\\n\| \)*# AGENTS.md instructions' \
             -e '^\(\\n\| \)*# Files mentioned by the user' -e '^\[Request interrupted' | head -1 || true)
  # A markdown link reads as its text ([$skill](/path) -> $skill). Cut
  # generously: the panel decides how much of it fits. Then trim whatever the
  # cut lands mid-token on — a dangling backslash reads as a rendering bug.
  snippet=$(printf '%s' "$snippet" | json_text | sed 's/\[\([^]]*\)\]([^)]*)/\1/g' \
    | cut -c1-240 | sed 's/[\\ ]*$//')
  str='\([^"\\]\|\\.\)*'
  case $1 in
    */rollout-*.jsonl)
      branch=$(head -1 "$1" | grep -o '"git":{[^}]*}' | grep -o '"branch":"[^"]*"' \
        | sed 's/^"branch":"//; s/"$//' || true)
      title=$(grep -F "\"id\":\"$(session_id_of "$1")\"" "${1%%/sessions/*}/session_index.jsonl" 2>/dev/null \
        | tail -1 | grep -o "\"thread_name\":\"$str\"" | sed 's/^"thread_name":"//; s/"$//' || true) ;;
    *)
      tags=$(grep -o -e "\"gitBranch\":\"$str\"" -e "\"customTitle\":\"$str\"" -e "\"aiTitle\":\"$str\"" "$1" 2>/dev/null || true)
      branch=$(printf '%s\n' "$tags" | sed -n 's/^"gitBranch":"\(.*\)"$/\1/p' | tail -1)
      title=$(printf '%s\n' "$tags" | sed -n 's/^"customTitle":"\(.*\)"$/\1/p' | tail -1)
      [ -n "$title" ] || title=$(printf '%s\n' "$tags" | sed -n 's/^"aiTitle":"\(.*\)"$/\1/p' | tail -1) ;;
  esac
  printf '%s\t%s\t%s\t%s\n' "$(session_cwd "$1")" "${snippet:-(no prompt)}" "$branch" \
    "$(printf '%s' "$title" | json_text)"
}

# Where one (profile, vendor) keeps its transcripts; nothing if it keeps none.
session_root() {  # profile, vendor
  sr_cfg=$(config_dir "$1" "$2")
  case $(vendor_sessions "$2") in
    projects) echo "$sr_cfg/projects" ;;   # projects/<slug>/<uuid>.jsonl
    sessions) echo "$sr_cfg/sessions" ;;   # sessions/<y>/<m>/<d>/rollout-*.jsonl
  esac
}

# Every transcript file for one (profile, vendor).
session_files() {  # profile, vendor
  sf_dir=$(session_root "$1" "$2")
  [ -n "$sf_dir" ] && [ -d "$sf_dir" ] || return 0
  find "$sf_dir" -type f -name '*.jsonl' 2>/dev/null
}

# Not every transcript is a conversation you had. Codex records its own
# helpers (the guardian that reviews tool calls, spawned agents) and `codex
# exec` one-shots; Claude keeps subagents under <session>/subagents/ and marks
# `claude -p` runs sdk-cli. Scripts and loops start these by the dozen, and
# none of them is worth resuming.
session_is_background() {  # path
  case $1 in
    */subagents/*) return 0 ;;
    */rollout-*.jsonl) head -1 "$1" 2>/dev/null | grep -q -e '"source":{"subagent"' -e '"source":"exec"' ;;
    *) [ "$(grep -m1 -o '"entrypoint":"[^"]*"' "$1" 2>/dev/null)" = '"entrypoint":"sdk-cli"' ] ;;
  esac
}

# Codex names files rollout-<timestamp>-<uuid>.jsonl; Claude names them <uuid>.jsonl.
session_id_of() {  # path
  b=$(basename "$1" .jsonl)
  case $b in
    rollout-*) printf '%s' "$b" | sed 's/^rollout-[0-9T:-]*-//' ;;
    *) echo "$b" ;;
  esac
}

# Locate a session's transcript. Echoes "profile<TAB>config-dir<TAB>jsonl";
# searches every profile when no profile is given.
find_session() {  # id, vendor, [profile]
  fs_id=$1 fs_v=$2
  if [ -n "${3:-}" ]; then fs_list=$3; else fs_list=$(all_profiles); fi
  for fs_n in $fs_list; do
    fs_cfg=$(config_dir "$fs_n" "$fs_v")
    session_files "$fs_n" "$fs_v" | while IFS= read -r fs_f; do
      [ "$(session_id_of "$fs_f")" = "$fs_id" ] && printf '%s\t%s\t%s\n' "$fs_n" "$fs_cfg" "$fs_f"
    done
  done | head -1 | grep . || return 1
}

# Reading a transcript's metadata means grepping all of it, and profiles hold
# thousands running to gigabytes. So each reading is kept, keyed by path and
# mtime, and a listing only opens what changed since the last one:
#   <path> <mtime> <background 0|1> [<session-id> <cwd> <prompt> <branch> <title>]
# Entries for transcripts that moved or changed drop out on the next write.
sessions_cache="$root/.sessions.v1.tsv"

# Machine-readable, newest first, across every profile and every lab whose
# transcripts we can read unless narrowed. A contract for the tray, like
# `porcelain`:
#   <profile> <vendor> <session-id> <mtime epoch> <cwd> <first prompt> <branch> <title>
sessions_porcelain() {  # profiles, vendors, limit ("" = all)
  mkdir -p "$root"
  touch "$sessions_cache"
  sp_list=$(mktemp) sp_new=$(mktemp) tab=$(printf '\t')
  for sp_n in $1; do
    for sp_v in $2; do
      sp_dir=$(session_root "$sp_n" "$sp_v")
      [ -n "$sp_dir" ] && [ -d "$sp_dir" ] || continue
      # One stat per batch of files, not per file: profiles hold thousands.
      find "$sp_dir" -type f -name '*.jsonl' -exec stat -f "%m%t$sp_n%t$sp_v%t%N" {} + 2>/dev/null
    done
  done | sort -rn > "$sp_list"
  # Rows already read come out finished (H), background ones not at all, and
  # the rest (M) are read below — only as many as --limit still wants.
  awk -F '\t' 'FILENAME == ARGV[1] { k = $1 FS $2; bg[k] = $3; id[k] = $4
                           meta[k] = substr($0, length($1 $2 $3 $4) + 5); next }
               { k = $4 FS $1
                 if (!(k in bg)) print "M" FS $0
                 else if (bg[k] == 0) print "H" FS $2 FS $3 FS id[k] FS $1 FS meta[k] }' \
    "$sessions_cache" "$sp_list" | {
    sp_left=${3:--1}
    while [ "$sp_left" != 0 ] && IFS= read -r sp_row; do
      case $sp_row in
        "H$tab"*) printf '%s\n' "${sp_row#H"$tab"}" ;;
        *)
          # mtime, profile, vendor, path: none empty, so splitting on tabs is safe.
          set -f; IFS=$tab; set -- $sp_row; IFS=' 	
'
          if session_is_background "$5"; then
            printf '%s\t%s\t1\n' "$5" "$2" >> "$sp_new"
            continue
          fi
          sp_id=$(session_id_of "$5") sp_meta=$(session_meta "$5")
          printf '%s\t%s\t0\t%s\t%s\n' "$5" "$2" "$sp_id" "$sp_meta" >> "$sp_new"
          printf '%s\t%s\t%s\t%s\t%s\n' "$3" "$4" "$sp_id" "$2" "$sp_meta" ;;
      esac
      sp_left=$((sp_left - 1))
    done
  }
  # What's still current plus what was just read, swapped in whole: two
  # listings at once can't interleave a file, and the last one simply wins.
  { awk -F '\t' 'FILENAME == ARGV[1] { now[$4 FS $1]; next } ($1 FS $2) in now' "$sp_list" "$sessions_cache"
    cat "$sp_new"; } > "$sessions_cache.$$"
  mv "$sessions_cache.$$" "$sessions_cache"
  rm -f "$sp_list" "$sp_new"
}

cmd_sessions() {
  name="" vsel="" porcelain=0 limit=""
  while [ $# -gt 0 ]; do
    case $1 in
      --vendor) vsel=${2:-}; shift 2 ;;
      --vendor=*) vsel=${1#--vendor=}; shift ;;
      --porcelain) porcelain=1; shift ;;
      --limit) limit=${2:-}; shift 2 ;;
      -*) die "unknown flag: $1" ;;
      *) name=$1; shift ;;
    esac
  done
  if [ "$porcelain" = 1 ]; then
    case $limit in ''|*[!0-9]*) [ -z "$limit" ] || die "--limit takes a number" ;; esac
    if [ -n "$name" ]; then
      want=$name; profiles=$(resolve_profile "$want") || die "no profile named '$want'"
    else
      profiles=$(all_profiles)
    fi
    if [ -n "$vsel" ]; then
      vendors=$(one_vendor "$vsel")
    else
      vendors=$(for x in $(vendors_installed); do [ "$(vendor_sessions "$x")" != none ] && echo "$x"; done; true)
    fi
    sessions_porcelain "$profiles" "$vendors" "$limit"
    return 0
  fi
  if [ -z "$vsel" ]; then
    # Every lab that keeps sessions, each under its own heading.
    listed=0
    for x in $(vendors_installed); do
      [ "$(vendor_sessions "$x")" != none ] || continue
      out=$( (cmd_sessions ${name:+"$name"} --vendor "$x") 2>/dev/null) || continue
      [ "$listed" = 1 ] && echo ""
      echo "$(vendor_label "$x"):"
      printf '%s\n' "$out"
      listed=1
    done
    [ "$listed" = 1 ] || die "no sessions in '${name:-Default}'"
    return 0
  fi
  v=$(one_vendor "$vsel")
  [ "$(vendor_sessions "$v")" != none ] || \
    die "$(vendor_label "$v") stores sessions in a format agents doesn't read yet"
  name=$(resolve_profile "${name:-Default}") || die "no profile named '$name'"

  # The same rows the tray reads, as a table: its title when it has one.
  rows=$(sessions_porcelain "$name" "$v" "")
  [ -n "$rows" ] || die "no $v sessions in '$name'"
  printf '%s\n' "$rows" | awk -F '\t' '{
    cmd = "date -r " $4 " \"+%Y-%m-%d %H:%M\""; cmd | getline when; close(cmd)
    n = split($5, dirs, "/"); proj = n ? dirs[n] : "—"
    printf "%s  %s  %-20s  %s%s\n", $3, when, proj, ($8 != "" ? $8 : $6), ($7 != "" ? "  [" $7 "]" : "")
  }'
}

cmd_transfer() {
  id="" from="" to="" prev="" vsel=""
  for arg in "$@"; do
    case $prev in
      --to) to=$arg; prev=""; continue ;;
      --from) from=$arg; prev=""; continue ;;
      --vendor) vsel=$arg; prev=""; continue ;;
    esac
    case $arg in
      --to|--from|--vendor) prev=$arg ;;
      --next) to="--next" ;;
      --best) to="--best" ;;
      -*) die "unknown flag: $arg" ;;
      *) id=$arg ;;
    esac
  done
  { [ -n "$id" ] && [ -n "$to" ]; } || \
    die "usage: agents transfer <id> --to <Profile>|--next|--best [--from <Profile>] [--vendor <v>]"
  if [ -z "$vsel" ]; then
    vsel=$(session_vendor "$id" ${from:+"$from"}) || die "session $id not found in any profile"
  fi
  v=$(one_vendor "$vsel")
  [ "$(vendor_sessions "$v")" != none ] || \
    die "$(vendor_label "$v") stores sessions in a format agents doesn't move yet"

  case $to in --next|--best) ;; *)
    want=$to; to=$(resolve_profile "$want") || die "no profile named '$want'"
  esac

  if [ -n "$from" ]; then
    want=$from; from=$(resolve_profile "$want") || die "no profile named '$want'"
    hit=$(find_session "$id" "$v" "$from") || die "session $id not found in '$from'"
  else
    hit=$(find_session "$id" "$v") || die "session $id not found in any profile"
    from=$(printf '%s\n' "$hit" | cut -f1)
  fi
  src_cfg=$(printf '%s\n' "$hit" | cut -f2)
  jsonl=$(printf '%s\n' "$hit" | cut -f3)
  if [ "$to" = "--next" ]; then
    to=$(rotation_next)
    [ "$to" = "$from" ] && to=$(rotation_next)
    echo "agents: rotating to profile '$to'" >&2
  elif [ "$to" = "--best" ]; then
    to=$(pick_best "$v" "$from") || die "no profile with a readable token — run 'agents best' to see why"
    echo "agents: best available profile is '$to'" >&2
  fi
  [ "$from" = "$to" ] && die "session is already in '$to'"

  dst_cfg=$(config_dir "$to" "$v")
  [ -d "$dst_cfg" ] || die "profile '$to' has no $v slot — create it: agents new $to --vendors $v"
  # Keep the transcript's position within the vendor's own tree (Claude's
  # projects/<slug>/, Codex's sessions/<y>/<m>/<d>/) so the CLI still finds it.
  rel=${jsonl#"$src_cfg"/}
  dst="$dst_cfg/$rel"
  [ -e "$dst" ] && die "'$to' already has session $id"
  mkdir -p "$(dirname "$dst")"
  mv "$jsonl" "$dst"

  # Per-session side data (env, edited-file history, todos) — best-effort, and
  # Claude-shaped; other vendors simply have none of these paths.
  for sub in "session-env/$id" "file-history/$id"; do
    if [ -e "$src_cfg/$sub" ] && [ ! -e "$dst_cfg/$sub" ]; then
      mkdir -p "$dst_cfg/$(dirname "$sub")"
      mv "$src_cfg/$sub" "$dst_cfg/$sub" 2>/dev/null || true
    fi
  done
  for f in "$src_cfg"/todos/"$id"*; do
    [ -e "$f" ] || continue
    mkdir -p "$dst_cfg/todos"
    mv "$f" "$dst_cfg/todos/" 2>/dev/null || true
  done

  cwd=$(session_cwd "$dst")
  echo "Moved $v session $id: $from -> $to"
  invoke="agents run $to --vendor $v --start-from-session=$id"
  if [ -n "$cwd" ]; then
    echo "Resume: cd \"$cwd\" && $invoke"
  else
    echo "Resume: $invoke"
  fi
}

# --- desktop ---------------------------------------------------------------

# A profile's desktop app. `clone` labs (Claude) have one app per profile;
# `launch` labs (Codex) have a single app that signs in as the lab's active
# profile — launched apps don't inherit env vars, so it can't be pinned — so
# opening it for another profile makes that profile active, which --switch
# confirms.
cmd_desktop() {
  name="" vsel="" switch=0
  while [ $# -gt 0 ]; do
    case $1 in
      --vendor) vsel=${2:-}; shift 2 ;;
      --vendor=*) vsel=${1#--vendor=}; shift ;;
      --switch) switch=1; shift ;;
      --next|--best) name=$1; shift ;;
      *) name=$1; shift ;;
    esac
  done
  if [ -z "$vsel" ]; then
    # Only a lab whose desktop is cloned per profile has a profile's desktop.
    dv=$(for x in $(vendors_installed); do [ "$(vendor_desktop "$x")" = clone ] && echo "$x"; done; true)
    [ "$(printf '%s\n' "$dv" | grep -c .)" = 1 ] || die "which lab? pass --vendor <v>"
    vsel=$dv
  fi
  v=$(one_vendor "$vsel")
  [ "$(vendor_desktop "$v")" != none ] || die "$(vendor_label "$v") has no desktop app"

  case ${name:-} in
    --next) name=$(rotation_next); echo "agents: rotating to profile '$name'" >&2 ;;
    --best) name=$(pick_best "$v") || die "no profile with a readable token — run 'agents best' to see why"
            echo "agents: best available profile is '$name'" >&2 ;;
    "")     pick=$(next_best "$(all_profiles)" "$v") || die "no profile with room left (see: agents best)"
            name=${pick% *}
            echo "agents: next best is '$name'" >&2 ;;
    *)      want=$name; name=$(resolve_profile "$want") || die "no profile named '$want'" ;;
  esac
  if [ "$(vendor_desktop "$v")" = launch ]; then
    dapp=$(vendor_desktop_name "$v")
    [ -n "$(mdfind "kMDItemCFBundleIdentifier == '$(vendor_desktop_bundle "$v")'" 2>/dev/null | head -1)" ] || \
      die "$dapp isn't installed"
    cur=$(active_profile "$v")
    if [ "$cur" != "$name" ]; then
      [ "$switch" = 1 ] || die "$dapp signs in as $(vendor_label "$v")'s active profile ('$cur'), not per profile.
  Make '$name' active and open it:  agents desktop $name --vendor $v --switch"
      switch_vendor "$name" "$v" >&2
    fi
    open -b "$(vendor_desktop_bundle "$v")"
    return 0
  fi
  if [ "$name" = Default ]; then
    app=$(claude_app_path) || die "Claude Desktop is not installed — get it from https://claude.ai/download"
    open -a "$app"
  else
    open -a "/Applications/Claude-$name.app"
  fi
}

# --- misc ------------------------------------------------------------------

cmd_active() {
  vsel=""
  while [ $# -gt 0 ]; do
    case $1 in
      --vendor) vsel=${2:-}; shift 2 ;;
      --vendor=*) vsel=${1#--vendor=}; shift ;;
      *) shift ;;
    esac
  done
  if [ -n "$vsel" ]; then
    active_profile "$(one_vendor "$vsel")"
  else
    active_summary
  fi
}

cmd_version() {
  plist="$scripts_dir/../Info.plist"
  if [ -f "$plist" ]; then
    /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$plist"
  else
    git -C "$scripts_dir" describe --tags --abbrev=0 2>/dev/null | sed 's/^v//' || echo "0.0.0"
  fi
}

cmd_app_path() {
  claude_app_path || die "Claude Desktop is not installed — get it from https://claude.ai/download"
}

cmd_profiles() { all_profiles; }

authed_word() {  # vendor, slot dir, profile
  if vendor_authed "$1" "$2" "$3"; then echo yes; elif [ $? = 1 ]; then echo no; else echo unknown; fi
}

# Which of a profile's slots hold a login. Profile setup polls this while its
# window is open, so it touches nothing but the adapter's cheap check.
cmd_authed() {
  [ -n "${1:-}" ] || die "usage: agents authed <Profile>"
  want=$1; name=$(resolve_profile "$want") || die "no profile named '$want'"
  for v in $(vendors_installed); do
    d=$(config_dir "$name" "$v")
    [ -d "$d" ] || continue
    printf '%s\t%s\n' "$v" "$(authed_word "$v" "$d" "$name")"
  done
}

# Stable TSV for the tray app, so the menu never re-implements any of the logic
# above. Padding and emoji belong to the human-facing commands; this one is a
# contract, and it is the only thing the Swift side parses.
#
#   V <vendor> <installed 0|1> <isolation> <desktop> <usage> <label> <sessions> <monogram> <desktop app name> <desktop bundle id>
#   P <profile> <desktop-running 0|1> <vendor,vendor,…  or "-">
#   S <profile> <vendor> <slot-dir> <account or ""> <signed in: yes|no|unknown>   one per slot
#   L <profile> <vendor>        the last slot `run` started ("next best" starts after it)
#   A <active-summary>
cmd_porcelain() {
  for v in $N2_VENDORS; do
    if vendor_installed "$v"; then i=1; else i=0; fi
    printf 'V\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$v" "$i" "$(vendor_isolation "$v")" "$(vendor_desktop "$v")" \
      "$(vendor_usage "$v")" "$(vendor_label "$v")" "$(vendor_sessions "$v")" "$(vendor_monogram "$v")" \
      "$(vendor_desktop_name "$v")" "$(vendor_desktop_bundle "$v")"
  done
  for n in $(all_profiles); do
    if profile_running "$n"; then r=1; else r=0; fi
    slots=""
    for v in $(vendors_installed); do
      d=$(config_dir "$n" "$v")
      [ -d "$d" ] || continue
      if [ "$(active_profile "$v")" = "$n" ]; then s="$v:active"; else s="$v:ok"; fi
      if [ -z "$slots" ]; then slots=$s; else slots="$slots,$s"; fi
      printf 'S\t%s\t%s\t%s\t%s\t%s\n' "$n" "$v" "$d" "$(vendor_account "$v" "$d")" "$(authed_word "$v" "$d" "$n")"
    done
    printf 'P\t%s\t%s\t%s\n' "$n" "$r" "${slots:--}"
  done
  if [ -f "$slot_file" ]; then
    ls_slot=$(cat "$slot_file" 2>/dev/null)
    printf 'L\t%s\t%s\n' "${ls_slot%%:*}" "${ls_slot#*:}"
  fi
  printf 'A\t%s\n' "$(active_summary)"
}

cmd_help() {
  sed -n '3,23p' "$self" | sed 's/^# \{0,3\}//'
}

cmd=${1:-help}
[ $# -ge 1 ] && shift
case $cmd in
  list)     cmd_list "$@" ;;
  vendors)  cmd_vendors "$@" ;;
  active)   cmd_active "$@" ;;
  use)      cmd_use "$@" ;;
  run)      cmd_run "$@" ;;
  best)     cmd_best "$@" ;;
  new)      cmd_new "$@" ;;
  delete)   cmd_delete "$@" ;;
  repatch)  cmd_repatch "$@" ;;
  adopt)    cmd_adopt "$@" ;;
  sessions) cmd_sessions "$@" ;;
  login)    cmd_login "$@" ;;
  authed)   cmd_authed "$@" ;;
  transfer) cmd_transfer "$@" ;;
  desktop)  cmd_desktop "$@" ;;
  shims)    cmd_shims "$@" ;;
  app-path) cmd_app_path ;;
  profiles) cmd_profiles ;;
  porcelain) cmd_porcelain ;;
  version)  cmd_version ;;
  help|-h|--help) cmd_help ;;
  *) die "unknown command: $cmd (try: agents help)" ;;
esac
