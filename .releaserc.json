{
  "branches": ["release", { "name": "main", "prerelease": "continuous" }],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/exec", {
      "prepareCmd": "./scripts/release-prepare.sh ${nextRelease.version}"
    }],
    ["@semantic-release/github", {
      "assets": [
        { "path": "N2Agents.zip", "name": "N2Agents.zip", "label": "N2Agents.app (zip)" },
        { "path": "N2Agents-*-*.zip", "label": "Sparkle update archive" }
      ]
    }],
    ["@semantic-release/exec", {
      "publishCmd": "./scripts/publish-appcast.sh ${nextRelease.version} ${nextRelease.gitTag}"
    }]
  ]
}
